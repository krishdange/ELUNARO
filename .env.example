# Copy to `.env` and fill in only the values you actually have.
# Every value is optional — the site shows honest fallbacks when they are empty.

# Endpoint that accepts a JSON POST of the project inquiry form
# (e.g. a Formspree / Basin / Getform endpoint, or your own serverless function).
VITE_FORM_ENDPOINT=

# Public contact address. Enables the mailto fallback and the footer contact link.
VITE_CONTACT_EMAIL=
